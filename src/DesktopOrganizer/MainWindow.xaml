<Window x:Class="DesktopOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Organizer"
        Width="920" Height="700"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="1" Opacity="0.06" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#D0D5DD" CornerRadius="13">
                            <Ellipse x:Name="Thumb"
                                     Width="20" Height="20"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="White" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0F6CBD" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Desktop Organizer" FontSize="24" FontWeight="SemiBold" Foreground="#101828" />
                    <TextBlock Text="A quieter Desktop, automatically." FontSize="13" Foreground="#667085" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="#ECFDF3" CornerRadius="16" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#12B76A" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="Ready" Foreground="#027A48" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28" MaxWidth="980">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Your Desktop" FontSize="13" Foreground="#667085" />
                            <TextBlock x:Name="MainStatusText"
                                       Text="Checking your Desktop…"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="#101828"
                                       Margin="0,5,0,8" />
                            <TextBlock Text="Obvious files are handled locally. AI is only used when extra context can help."
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="#667085" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="OrganizeNowButton" Content="Organize now" Width="150" Click="OrganizeNow_Click" />
                            <Button x:Name="OpenFolderButton" Content="Open organized files" Width="150" Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Automation" FontSize="18" FontWeight="SemiBold" Foreground="#101828" />
                        <TextBlock Text="Keep watching the Desktop after this window is closed."
                                   FontSize="13" Foreground="#667085" Margin="0,4,0,18" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Automatic organizing" FontSize="14" FontWeight="SemiBold" Foreground="#344054" />
                                <TextBlock Text="React to new Desktop files using low-overhead Windows file events."
                                           FontSize="12" Foreground="#667085" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="AutoOrganizeToggle" Grid.Column="1" Style="{StaticResource ToggleStyle}"
                                          VerticalAlignment="Center" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AI classification" FontSize="18" FontWeight="SemiBold" Foreground="#101828" />
                                <TextBlock Text="Use OpenAI only for ambiguous documents and filenames."
                                           FontSize="13" Foreground="#667085" Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="AiToggle" Grid.Column="1" Style="{StaticResource ToggleStyle}"
                                          VerticalAlignment="Center" Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OpenAI API key" FontSize="12" Foreground="#667085" Margin="0,0,0,6" />
                                <PasswordBox x:Name="ApiKeyBox" PasswordChar="●" />
                                <TextBlock Text="Stored encrypted for your Windows account. It is never committed to this repository."
                                           FontSize="11" Foreground="#98A2B3" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Save" Margin="12,22,0,0" Width="92" Height="40" Click="SaveSettings_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Recent activity" FontSize="18" FontWeight="SemiBold" Foreground="#101828" />
                                <TextBlock x:Name="ActivitySummaryText" Text="Nothing organized yet."
                                           FontSize="13" Foreground="#667085" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button x:Name="UndoButton" Grid.Column="1" Content="Undo selected" Width="126"
                                    Style="{StaticResource SecondaryButton}" Click="Undo_Click" />
                        </Grid>

                        <ListBox x:Name="ActivityList"
                                 ItemsSource="{Binding Activities}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="270"
                                 SelectionChanged="ActivityList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#344054"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#667085" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayMethod}" Foreground="#667085"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="#98A2B3"
                                                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="Tip: close this window whenever you like — Desktop Organizer stays available in the system tray."
                           HorizontalAlignment="Center" Foreground="#98A2B3" FontSize="12" Margin="0,2,0,22" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
